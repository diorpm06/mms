{
  "buildCommand": "npm install --prefix frontend && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/uploads/(.*)", "destination": "/api/index.py" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/sw.mjs", "destination": "/sw.mjs" },
    { "source": "/manifest.webmanifest", "destination": "/manifest.webmanifest" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/(.*)", "destination": "/api/index.py" }
  ]
}
