# ── Ma'lumotlar bazasi ──────────────────────────────────
# SQLite (lokal dev uchun):
DATABASE_URL=sqlite:///./marjona_med.db
# PostgreSQL (production uchun - Supabase dan oling):
# DATABASE_URL=postgresql://user:password@host:5432/marjona_med

# ── Xavfsizlik ──────────────────────────────────────────
# Yangi key generatsiya: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_STRONG_RANDOM_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Telegram bot ────────────────────────────────────────
BOT_TOKEN=
CEO_CHAT_ID=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_IDS=
TELEGRAM_TOPIC_REGISTRATION=
TELEGRAM_TOPIC_INPATIENTS=
TELEGRAM_TOPIC_FINANCE=
TELEGRAM_TOPIC_REPORTS=
TELEGRAM_TOPIC_CANCELLATIONS=
TELEGRAM_TOPIC_SYSTEM=

# ── Google Sheets ────────────────────────────────────────
GOOGLE_SHEETS_CREDENTIALS=credentials.json
SPREADSHEET_ID=

# ── Frontend URL (CORS uchun) ────────────────────────────
# Vercel deploy bo'lgandan keyin shu yerga URL kiriting:
FRONTEND_URL=https://your-app.vercel.app

# ── Sheets webhook ────────────────────────────────────────
SHEETS_WEBHOOK_SECRET=
