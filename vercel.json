{
  "buildCommand": "npm install --prefix frontend && npm run build --prefix frontend",
  "regions": ["hnd1"],
  "rewrites": [
    { "source": "/:path+", "destination": "/api/index.py?__v_path=/:path*" },
    { "source": "/",       "destination": "/api/index.py?__v_path=/" }
  ],
  "crons": [
    { "path": "/api/cron/run-daily", "schedule": "0 15 * * *" }
  ]
}
